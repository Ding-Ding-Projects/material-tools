{
  "name": "material-tools",
  "productName": "Material Tools",
  "version": "0.1.0",
  "description": "A Material Design 3 Windows utility with WinUtil-compatible capabilities.",
  "author": "Ding-Ding-Projects",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:main": "tsc -p tsconfig.main.json && node scripts/bundle-preload.mjs",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "start:built": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "check:preload": "node scripts/validate-preload-bundle.mjs",
    "check:release-workflow": "node scripts/validate-release-workflow.mjs",
    "check": "npm run check:release-workflow && npm run typecheck && npm test && npm run build && npm run check:preload",
    "capture:ui": "node scripts/capture-ui.mjs",
    "dist": "npm run build && electron-builder --win squirrel --publish never"
  },
  "build": {
    "appId": "com.dingdingprojects.materialtools",
    "productName": "Material Tools",
    "asar": true,
    "forceCodeSigning": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "win": {
      "signExecutable": false,
      "signAndEditExecutable": false,
      "target": [
        "squirrel"
      ]
    },
    "squirrelWindows": {
      "artifactName": "MaterialTools-Setup-${version}-${arch}.${ext}",
      "msi": false,
      "iconUrl": "https://raw.githubusercontent.com/Ding-Ding-Projects/material-tools/main/assets/app-icon.ico"
    }
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
